# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# SQL Server (use a read-only login)
SQL_SERVER=your-server-name-or-ip
# Optional. Leave blank for the default port, or write it here instead of in SQL_SERVER (host,1433)
SQL_PORT=
SQL_DATABASE=your-database-name
SQL_USER=your-readonly-login
SQL_PASSWORD=your-password
# Optional: driver name as installed on your computer, and whether to trust the server certificate
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUST_CERT=yes

# Optional: only if the app cannot find the month column in the MIS sheet by itself. Exact header text.
MIS_MONTH_COLUMN=
MIS_YEAR_COLUMN=

# Optional: random text used to sign login cookies. Leave as is and the app makes and keeps its own.
SECRET_KEY=change-me

# Logging in: run `python manage.py create-admin you@company.com` once. The admin then adds people on the Users page.
# Address people use to reach the app, put in set-password links. Leave blank to use the address the admin is on.
APP_BASE_URL=
# Mail server for the set-password emails. Without it the admin copies the link and sends it themselves.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HeritageEdge <no-reply@yourcompany.com>
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
